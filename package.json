{
  "name": "super-deepseek-harness-git",
  "version": "1.1.2",
  "private": true,
  "type": "module",
  "description": "Super-DeepSeek-Harness Git sync: settings-pane GitHub section to sign in, push DSH config to your private repo via the REST API (works behind git-blocked corporate networks), and restore on a new machine",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Superarting/Super-DeepSeek-Harness-Git.git"
  },
  "homepage": "https://github.com/Superarting/Super-DeepSeek-Harness-Git#readme",
  "bugs": "https://github.com/Superarting/Super-DeepSeek-Harness-Git/issues",
  "license": "MIT",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg"
  ],
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.19.0"
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true
    }
  }
}
